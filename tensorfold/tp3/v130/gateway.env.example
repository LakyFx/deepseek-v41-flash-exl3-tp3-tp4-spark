# Preserve the operator's existing key and durable jobs DB; never copy a secret.
DS41F_RECIPE_VERSION=1.3.0
DS41F_GATEWAY_PROFILE=/ABSOLUTE/PATH/TO/1.3.0/gateway-profile.json
LAGUNA_GATEWAY_API_KEY=REPLACE_WITH_EXISTING_OPERATOR_SECRET
LAGUNA_GATEWAY_UPSTREAM=http://127.0.0.1:8003
LAGUNA_GATEWAY_VISION_UPSTREAM=http://127.0.0.1:8003
DS41F_GATEWAY_STATE_DIR=/ABSOLUTE/PATH/TO/EXISTING/GATEWAY/STATE
DGX_VISION_JOBS_DB=/ABSOLUTE/PATH/TO/EXISTING/jobs.sqlite3
DGX_VISION_JOBS_REVISION=d021774d38c0e7c684e6da44f39f22e735deb14b
DGX_MEDIA_SERIAL_REQUESTS=1
DGX_MEDIA_MAX_CONCURRENCY=2
DGX_VISION_CONTROL_ENABLED=1
DGX_VISION_REASONING_EFFORT=max
DGX_VISION_THINKING_BUDGET=8192
DGX_VISION_FINAL_ANSWER_TOKENS=32768
DGX_VISION_JOB_TIMEOUT_SECONDS=3590
DGX_VISION_QUEUE_TIMEOUT_SECONDS=1800
DGX_VISION_CANCEL_GRACE_SECONDS=60

LAGUNA_GATEWAY_TENSORFOLD_CLIENT_JSON=1
