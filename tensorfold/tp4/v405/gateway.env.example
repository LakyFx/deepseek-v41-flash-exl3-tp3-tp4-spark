# Additional overrides for the existing ds41f-gateway entrypoint.
# Keep your credentials, persistent vision DB and all other private settings.
DS41F_RECIPE_VERSION=4.0.5
# The portable entrypoint reads capacity from this JSON, not LAGUNA_* overrides.
DS41F_GATEWAY_PROFILE=/REPLACE_RECIPE_CHECKOUT/tensorfold/tp4/v405/gateway-profile.json
LAGUNA_GATEWAY_UPSTREAM=http://REPLACE_HEAD_ADDRESS:8003
LAGUNA_GATEWAY_VISION_UPSTREAM=http://REPLACE_HEAD_ADDRESS:8003
DGX_VISION_REASONING_EFFORT=max
DGX_VISION_THINKING_BUDGET=8192
DGX_VISION_FINAL_ANSWER_TOKENS=32768
DGX_MEDIA_MAX_CONCURRENCY=2
DGX_VISION_RECOVERY_ATTEMPTS=2
DGX_VISION_CONTROL_ENABLED=1
DGX_MEDIA_SERIAL_REQUESTS=1
# Gateway overrides only. Preserve the existing DGX_VISION_JOBS_DB, upstream,
# credentials and other gateway settings; this is not a complete environment.
DGX_VISION_JOB_TIMEOUT_SECONDS=3590
DGX_VISION_QUEUE_TIMEOUT_SECONDS=1800

# Native TensorFold internal JSON contract with strict result validation.
LAGUNA_GATEWAY_TENSORFOLD_INTERNAL_JSON=1

# Validate explicit caller JSON requests, with bounded repair.
LAGUNA_GATEWAY_TENSORFOLD_CLIENT_JSON=1
